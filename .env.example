# URL pública HTTPS do seu WebApp para abrir dentro do Telegram.
# Localhost funciona no navegador; para Telegram real use ngrok/cloudflare tunnel/VPS HTTPS.
# Para teste no navegador: http://localhost:3000
# Para abrir no Telegram: precisa ser HTTPS público, ex: https://seu-tunnel.trycloudflare.com
WEBAPP_URL=https://0ef6-152-234-89-69.ngrok-free.app

PORT=3000
HOST=0.0.0.0
APP_NAME=Sky Pilot MVP
HOUSE_EDGE=0.04
STARTING_BALANCE=1000
ROUND_TICK_MS=90
MAX_BET=500
MIN_BET=1

